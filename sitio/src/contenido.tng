log(evens, evens.sum())',
    table: {
      columns: ["Método", "Qué hace"],
      rows: [
        ['`push(x)`, `pop()`, `insert(i, x)`, `remove(i)`', 'Agregan o quitan elementos. Cambian la lista.'],
        ['`map(f)`, `filter(f)`', 'Transforman o filtran cada elemento.'],
        ['`fold(inicial, f)`, `reduce(f)`', 'Combinan todo en un solo valor.'],
        ['`find(f)`, `position(f)`', 'Primer elemento que cumple `f`, o su posición.'],
        ['`any(f)`, `all(f)`, `count(f)`', 'Si alguno o todos cumplen `f`, o cuántos.'],
        ['`contains(x)`, `index_of(x)`', 'Si la lista tiene `x`, y dónde.'],
        ['`sorted()`, `sorted_by(f)`, `sorted_by_key(f)`, `reversed()`', 'Copias ordenadas o invertidas.'],
        ['`enumerate()`, `zip(otra)`, `chunks(n)`', 'Pares posición y valor, pares de dos listas, o grupos de `n`.'],
        ['`slice(a, b)`, `take(n)`, `skip(n)`', 'Copias de un pedazo de la lista.'],
        ['`unique()`, `flatten()`, `join(sep)`', 'Sin repetidos, aplanada, o unida en un string.'],
