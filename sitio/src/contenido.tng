        ['`n.is_even()`, `n.is_odd()`, `n.clamp(a, b)`, `n.to_int()`, `n.times(f)`', 'Más métodos útiles de los números.'],
        ['`x.to_string()`', 'Convierte cualquier valor en string.'],
        ['`state(v)`, `computed(f)`, `effect(f)`', 'Estado reactivo: ver la sección Estado reactivo.'],
        ['`render_html(componente)`', 'El HTML que dibuja un componente, como texto.'],
        ['`fetch_json(url)`, `fetch_text(url)`, `sleep(ms)`', 'Pedir datos a una API o esperar, con `await`.'],
      ],
    },
