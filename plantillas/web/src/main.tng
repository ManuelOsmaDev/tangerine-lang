// La página es un struct con view { }. Lo que marques con @State, al cambiar, se vuelve a dibujar solo.
struct App {
  @State var cuenta = 0

  view {
    main(.tarjeta) {
      h1 { "Hola desde Tangerine" }
      p(.lema) { "Edita src/main.tng y guarda: la página se recarga sola." }
      p(.numero) { "{cuenta}" }
      div(.botones) {
        button(.boton, "−") { cuenta -= 1 }
        button(.boton, .primario, "+") { cuenta += 1 }
      }
    }
  }
}

mount("#app", App)
