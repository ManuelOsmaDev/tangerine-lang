    code: 'export fn Contador(props) {
  let (n, set_n) = use_state(props.inicio ?? 0)

  h("div", { class: "contador" },
    h("button", { on_click: || set_n(|x| x - 1) }, "−"),
    h("span", nil, n),
    h("button", { on_click: || set_n(|x| x + 1) }, "+"),
  )
}',
    runnable: false,
