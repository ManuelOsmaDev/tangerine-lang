log(mezclar(NARANJA, paleta.blanco))',
    runnable: false,
    table: {
      columns: ["Comando", "Qué hace"],
      rows: [
        ['`tangerine add nombre`', 'Instala un paquete de npm.'],
        ['`tangerine add usuario/repo`', 'Instala un paquete desde GitHub.'],
        ['`tangerine remove nombre`', 'Lo desinstala.'],
        ['`tangerine buscar texto`', 'Busca paquetes de Tangerine publicados en npm.'],
      ],
    },
