{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tangerine",
  "scopeName": "source.tangerine",
  "fileTypes": ["tng"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#calls" },
        { "include": "#operators" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.tangerine", "match": "//.*$" },
        { "name": "comment.block.tangerine", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tangerine",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.tangerine", "match": "\\\\." },
            {
              "name": "meta.interpolation.tangerine",
              "begin": "\\{", "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.tangerine" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.tangerine" } },
              "contentName": "source.tangerine.embedded",
              "patterns": [{ "include": "#code" }]
            }
          ]
        },
        {
          "name": "string.quoted.single.tangerine",
          "begin": "'", "end": "'",
          "patterns": [{ "name": "constant.character.escape.tangerine", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.tangerine", "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?\\b" }]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z\\u00C0-\\u024F_][\\w\\u00C0-\\u024F]*)",
          "captures": { "1": { "name": "storage.type.function.tangerine" }, "2": { "name": "entity.name.function.tangerine" } }
        },
        {
          "match": "\\b(class|struct)\\s+([A-Za-z_][\\w]*)(?:\\s*:\\s*([A-Za-z_][\\w]*))?",
          "captures": {
            "1": { "name": "storage.type.class.tangerine" },
            "2": { "name": "entity.name.type.class.tangerine" },
            "3": { "name": "entity.other.inherited-class.tangerine" }
          }
        },
        {
          "match": "\\b(let|var)\\s+([A-Za-z\\u00C0-\\u024F_][\\w\\u00C0-\\u024F]*)",
          "captures": { "1": { "name": "storage.type.tangerine" }, "2": { "name": "variable.other.declaration.tangerine" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.tangerine", "match": "\\b(if|else|match|while|loop|for|in|break|continue|return|do|catch|throw)\\b" },
        { "name": "keyword.control.import.tangerine", "match": "\\b(import|export|from|as)\\b" },
        { "name": "storage.type.tangerine", "match": "\\b(let|var|fn|class|struct)\\b" },
        { "name": "variable.language.tangerine", "match": "\\b(self|super)\\b" },
        { "name": "variable.parameter.closure.tangerine", "match": "\\|(?=[^|\\n]*\\|)|\\|\\|" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.tangerine", "match": "\\b(true|false|nil|PI)\\b" }
      ]
    },
    "types": {
      "patterns": [{ "name": "entity.name.type.tangerine", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }]
    },
    "calls": {
      "patterns": [
        { "name": "support.function.builtin.tangerine", "match": "\\b(mount|render_html|state|computed|effect|bind|render|is_state|println|print|type_of|assert|min|max|random|random_int|to_json|from_json|read_file|write_file|file_exists|list_dir|args|env|exit|h|fragment|use_state|use_effect|use_memo|use_ref|query|query_all|el|append|on|attr|set_text|toggle_class)(?=\\s*\\()" },
        { "name": "entity.name.function.call.tangerine", "match": "\\b[a-z_\\u00C0-\\u024F][\\w\\u00C0-\\u024F]*(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.tangerine", "match": "\\.\\.=?" },
        { "name": "keyword.operator.tangerine", "match": "=>|->|\\?\\?|\\?\\.|&&|\\|\\||==|!=|<=|>=|\\+=|-=|\\*=|/=|\\*\\*|[+\\-*/%<>=!]" }
      ]
    }
  }
}
