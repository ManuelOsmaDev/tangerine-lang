        ['`query_all(selector)`, `set_style(e, prop, valor)`', 'Busca todos los elementos que coinciden o cambia un estilo.'],
        ['`after(ms, f)`, `save(clave, valor)`, `load(clave)`', 'Ejecuta algo más tarde, o guarda y lee datos en el navegador.'],
        ['`run(código)`', 'Ejecuta otro programa de Tangerine y devuelve su salida. Así funciona el playground.'],
      ],
    },
  },
]

export let samples = [
  { file: "contador.tng", code: '@Component("mi-contador")
struct Contador {
  @Input var paso = 1
  @Output var cambio
  @State var cuenta = 0

  fn sumar() {
    cuenta += paso
    cambio.emit(cuenta)
  }

  view {
    div(.tarjeta) {
      p(.numero) { "{cuenta}" }
      button("+") { sumar() }
    }
  }
}

let c = Contador()
c.paso = 2
c.cambio.listen(|v| log("cambio: {v}"))
c.sumar()
log(render_html(c))' },
  { file: "hello.tng", code: 'let name = "world"
log("Hello, {name}!")
log("2 + 3 * 4 = {2 + 3 * 4}")' },
  { file: "fruit_stand.tng", code: 'struct Basket {
  var items = []

  fn add(fruit, kilos, price) {
    self.items.push({ fruit, kilos, price })
    self
  }

  fn total() -> Float {
    self.items.fold(0, |sum, x| sum + x.kilos * x.price)
  }
}

let basket = Basket()
  .add("mandarin", 2, 3200)
  .add("lime", 1, 2800)

for item in basket.items {
  log("{item.kilos} kg of {item.fruit}")
}
log("Total: ${basket.total()}")' },
  { file: "grades.tng", code: 'let scores = [95, 72, 88, 41, 100]

for s in scores {
  let grade = match s {
    90..=100 => "A",
    80..90 => "B",
    60..80 => "C",
    _ => "F",
  }
  log("{s.to_string().pad_start(3)} -> {grade}")
}

let avg = scores.sum() / scores.len()
log("Average: {avg.round(1)}")' },
  { file: "inventory.tng", code: 'let stock = {
  mandarin: 40,
  lime: 12,
  grapefruit: 0,
}

for (fruit, qty) in stock {
  let status = if qty == 0 { "sold out" } else { "{qty} left" }
  log("{fruit}: {status}")
}' },
  { file: "errors.tng", code: 'fn parse_age(text) -> Int {
  let age = text.parse()
  if age == nil {
    throw "\'{text}\' is not a number"
  }
  age
}

for input in ["21", "twenty", "35"] {
  do {
    log("Age:", parse_age(input))
  } catch e {
    log("Error:", e.message)
  }
}' },
  { file: "fizzbuzz.tng", code: 'for i in 1..=15 {
  let out = match i {
    n if n % 15 == 0 => "FizzBuzz",
    n if n % 3 == 0 => "Fizz",
    n if n % 5 == 0 => "Buzz",
    n => n.to_string(),
  }
  log(out)
}' },
  { file: "counter.tng", code: 'fn make_counter() {
  var count = 0
  {
    increment: || { count += 1 },
    value: || count,
  }
}

let c = make_counter()
3.times(|_| c.increment())
log("count:", c.value())' },
  { file: "fibonacci.tng", code: 'let memo = {}

fn fib(n: Int) -> Int {
  if n < 2 { return n }
  if memo.has(n) { return memo[n] }
  let result = fib(n - 1) + fib(n - 2)
  memo[n] = result
  result
}

for n in [10, 30, 70] {
  log("fib({n}) = {fib(n)}")
}' },
]

export let features = [
  { id: "match", icon: "match", title: "Pattern matching", text: "Compara un valor con rangos, opciones y condiciones en un solo bloque claro." },
  { id: "componentes", icon: "@State", title: "Componentes", text: 'Un struct con view { }, como en SwiftUI. Lo que marcas con @State se vuelve a dibujar solo.' },
  { id: "clases", icon: "class", title: "Clases y herencia", text: "Campos con valor inicial, init y super. Sin new ni self., como en Swift." },
  { id: "frameworks", icon: "<mi-x>", title: "Angular, React y Vue", text: "Cada @Component es un Web Component: úsalo en la app que ya tienes, sin reescribirla." },
  { id: "modulos", icon: "import", title: "Módulos", text: "Divide tu programa en archivos con import y export, y reutilízalos donde quieras." },
  { id: "mapas", icon: "?.", title: "Nil seguro", text: "Encadena lecturas con ?. y da valores por defecto con ??." },
  { id: "listas", icon: "[ ]", title: "Listas expresivas", text: "Más de 30 métodos: map, filter, fold, zip, enumerate, sorted_by_key." },
  { id: "errores", icon: "¿?", title: "Errores que ayudan", text: "En español, con línea, columna y rastro de llamadas. Si te equivocas de nombre, te sugiere el correcto." },
]
