        ['`random()`, `random_int(a, b)`', 'Número al azar entre 0 y 1, o entero entre `a` y `b`.'],
        ['`assert(condición, mensaje)`', 'Lanza un error si la condición es falsa.'],
        ['`to_json(x)`, `from_json(texto)`', 'Convierten valores a JSON y de vuelta.'],
        ['`PI`', 'El número π.'],
