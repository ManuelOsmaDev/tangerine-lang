{
  "Función": { "prefix": "fn", "body": ["fn ${1:nombre}(${2:parametros}) {", "\t$0", "}"], "description": "Declara una función" },
  "Closure": { "prefix": "|", "body": ["|${1:x}| ${0:x}"], "description": "Función de una línea" },
  "Clase": { "prefix": "class", "body": ["class ${1:Nombre} {", "\tinit(${2:valor}) {", "\t\tself.${2:valor} = ${2:valor}", "\t}", "", "\tfn ${3:metodo}() {", "\t\t$0", "\t}", "}"], "description": "Declara una clase" },
  "Match": { "prefix": "match", "body": ["match ${1:valor} {", "\t${2:patron} => ${3:resultado},", "\t_ => ${0:otro},", "}"], "description": "Compara con varios patrones" },
  "If": { "prefix": "if", "body": ["if ${1:condicion} {", "\t$0", "}"] },
  "If else": { "prefix": "ife", "body": ["if ${1:condicion} {", "\t$2", "} else {", "\t$0", "}"] },
  "For": { "prefix": "for", "body": ["for ${1:x} in ${2:lista} {", "\t$0", "}"] },
  "For enumerate": { "prefix": "fore", "body": ["for (${1:i}, ${2:x}) in ${3:lista}.enumerate() {", "\t$0", "}"] },
  "Do catch": { "prefix": "do", "body": ["do {", "\t$1", "} catch ${2:e} {", "\tlog(${2:e}.message)", "}"] },
  "Import": { "prefix": "import", "body": ["import { ${2:nombre} } from \"${1:./modulo}\""] },
  "Log": { "prefix": "log", "body": ["log(${0})"] },
  "Componente de React": { "prefix": "comp", "body": ["export fn ${1:Componente}(props) {", "\tlet (${2:valor}, set_${2:valor}) = use_state(${3:nil})", "", "\th(\"${4:div}\", { class: \"${5:clase}\" },", "\t\t$0", "\t)", "}"] }
}
