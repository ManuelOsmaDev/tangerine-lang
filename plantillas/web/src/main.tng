let app = query("#app")
let tarjeta = append(app, el("main", "tarjeta", nil))
append(tarjeta, el("h1", nil, "Hola desde Tangerine"))
append(tarjeta, el("p", "lema", "Edita src/main.tng y guarda: la página se recarga sola."))

// Un estado: cuando cambia, todo lo que lo muestra se actualiza solo.
let cuenta = state(0)
append(tarjeta, el("p", "numero", cuenta))

let botones = append(tarjeta, el("div", "botones", nil))
on(append(botones, el("button", "boton", "−")), "click", || cuenta.update(|n| n - 1))
on(append(botones, el("button", "boton primario", "+")), "click", || cuenta.update(|n| n + 1))
